@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>
<form method="post">
    <label>Email:</label>
    <input asp-for="Email" type="email" required />

    <label>Password:</label>
    <input asp-for="Password" type="password" required />

    <button type="submit" class="btn-primary">Login</button>
</form>
